# Copy to .env on the server (chmod 600). Never commit .env.
DATABASE_URL=postgres://homebase:CHANGE_ME@postgres:5432/homebase
POSTGRES_PASSWORD=CHANGE_ME
HOMEBASE_RO_PASSWORD=CHANGE_ME
# 32 random bytes, base64:  openssl rand -base64 32
HOMEBASE_MASTER_KEY=
TZ=America/New_York
# Tailscale sidecar
TS_AUTHKEY=
TS_HOSTNAME=homebase
# Bootstrap secrets (moved into encrypted Settings → Connections after first run)
YNAB_TOKEN=
ANTHROPIC_API_KEY=
SIMPLEFIN_ACCESS_URL=
MERCURY_TOKEN=
RENTCAST_API_KEY=
WHISPER_URL=http://host.internal:8178
# Web Push contact (VAPID subject): a mailto: or https: URL. Placeholder when empty; editable in Settings → Notifications.
VAPID_SUBJECT=
# Cloudflare Tunnel (the cloudflared service): the tunnel token from the Zero Trust dashboard.
# Without one, cloudflared can't connect; stop that service if you only use Tailscale.
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare Access (optional): your Zero Trust team (<team>.cloudflareaccess.com) and the Access
# application's audience tag. Either empty = Access sign-in off.
HOMEBASE_CF_ACCESS_TEAM=
HOMEBASE_CF_ACCESS_AUD=
# Public demo (demo-postgres, demo-seed, demo-web): its own DB password and master key, never the real ones.
# Compose needs both set even if you never start the demo; server-bootstrap.sh generates them.
DEMO_POSTGRES_PASSWORD=
DEMO_MASTER_KEY=
